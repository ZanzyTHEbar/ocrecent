{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/ZanzyTHEbar/ocrecent.git",
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": "minor" },
          { "type": "style", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "test", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "type": "ci", "scope": "ci-*", "release": "patch" },
          { "type": "chore", "release": false },
          { "type": "no-release", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/update-package.sh ${nextRelease.version} && ./scripts/build-release.sh ${nextRelease.version}",
        "publishCmd": "test -s dist/checksums.txt"
      }
    ],
    [
      "@semantic-release/github",
      {
        "addReleases": "bottom",
        "assets": [
          { "path": "dist/*.tar.gz", "label": "Linux release archives" },
          { "path": "dist/checksums.txt", "label": "SHA-256 checksums" }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "packaging/PKGBUILD"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
